{
  "name": "hom-nay-an-gi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "server": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "db:up": "docker compose up -d mongo",
    "db:seed": "tsx server/seed.ts",
    "db:reset": "tsx server/seed.ts --reset",
    "db:ui": "docker compose --profile tools up -d mongo-express"
  },
  "dependencies": {
    "mongodb": "^6.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
