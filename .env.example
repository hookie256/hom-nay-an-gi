# ===== Giao diện (Vite) =====
# "http" = gọi server Node + MongoDB (mặc định). "mock" = máy chủ giả trong trình duyệt (không cần MongoDB).
VITE_API_MODE=http
# Địa chỉ API; mặc định /api (Vite proxy sang server ở cổng 4000)
VITE_API_BASE_URL=/api
VITE_TIMEZONE=Asia/Ho_Chi_Minh

# ===== Server API (npm run server) =====
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=hom_nay_an_gi
# Hiện liên kết đặt lại mật khẩu trên màn hình khi chưa có dịch vụ email (tắt ở production)
EXPOSE_RESET_LINK=true
